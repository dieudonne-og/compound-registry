{
  "name": "compound-registry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cr/api --filter @cr/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @cr/api test:integration",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "pnpm --filter @cr/api db:migrate",
    "db:seed": "pnpm --filter @cr/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "mysql2": "^3.24.5",
    "prettier": "^3.9.10",
    "typescript": "~5.6",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "rolldown": "1.2.12"
    }
  }
}
