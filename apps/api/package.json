{
  "name": "@cr/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsup src/main.ts src/db/migrate.ts src/db/seed.ts src/db/reset.ts --format esm --target node22 --clean --noExternal @cr/contracts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "start:e2e": "tsx src/db/reset.ts && tsx src/main.ts"
  },
  "dependencies": {
    "@cr/contracts": "workspace:^",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^4",
    "file-type": "21.3.4",
    "mysql2": "^3.24.5",
    "pino": "^10.4.0",
    "sharp": "0.35.5",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "4.21.0",
    "vitest": "^3"
  }
}
